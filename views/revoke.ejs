<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Abhedya | Revocation Registry</title>

  <!-- Links to your specific Revoke CSS file -->
  <link rel="stylesheet" href="/css/pages/revoke.css">
</head>

<body>

  <!-- Top Dark Navigation Bar -->
  <header>
    <div class="brand-section">
      <div class="brand-icon">
        <img src="/images/logo.jpeg" alt="Abhedya Logo" class="brand-logo-img">
      </div>
      <div class="brand-text">
        <h2>Abhedya</h2>
        <span>Credential Console</span>
      </div>
    </div>

    <!-- Corrected Top Navigation Links -->
    <ul class="nav-links">
      <li>
        <a href="/dashboard">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
          Overview
        </a>
      </li>
      <li>
        <a href="/dashboard/issue">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
          Issue & Verify
        </a>
      </li>
      <li>
        <a href="/dashboard/revoke" class="active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
          </svg>
          Revocation Registry
        </a>
      </li>
    </ul>

    <div class="header-right">
      <a href="/logout" style="text-decoration: none;">
        <button class="btn-logout">Logout</button>
      </a>
    </div>
  </header>

  <!-- Centered Content Canvas -->
  <main class="dashboard-content">

    <div class="page-header">
      <h1>Revocation Registry</h1>
      <p>Append-only revocation records for issued credentials.</p>
    </div>

    <!-- 2-Column Top Section -->
    <div class="revoke-grid">

      <!-- LEFT: Revoke Form Card -->
      <div class="card">
        <h2 class="card-title">Revoke a Credential</h2>
        <p class="card-desc">We never delete history — revoking appends a record and flips the status. The original
          stays visible for audit.</p>

        <form action="/revoke-action" method="POST">
          <div class="input-group">
            <label>Certificate ID</label>
            <!-- Changed to a text input so you can revoke any real dynamic ID -->
            <input type="text" name="certId" placeholder="e.g. CERT-XXXX" required
              style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; text-transform: uppercase; font-family: monospace; outline: none; margin-top: 5px;">
          </div>

          <div class="input-group" style="margin-top: 15px;">
            <label>Reason</label>
            <select name="reason" required
              style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; margin-top: 5px;">
              <option value="" disabled selected>Select revocation reason...</option>
              <option value="Academic misconduct discovered">Academic misconduct discovered</option>
              <option value="Administrative Discrepancy">Administrative Discrepancy</option>
              <option value="Duplicate Issuance">Duplicate Issuance</option>
              <option value="Student Requested Invalidation">Student Requested Invalidation</option>
            </select>
          </div>

          <button type="submit" class="btn-revoke-submit" style="margin-top: 20px;">
            <span>⏱️</span> Revoke Certificate
          </button>
        </form>
      </div>

      <!-- RIGHT: "Why this matters" Info Card -->
      <div class="card revoke-info-card">
        <div class="info-box-top">
          <div class="warning-icon-bg">⚠️</div>
          <div>
            <div class="info-tag">VERIFICATION PORTAL NOW SHOWS</div>
            <h3>Certificate Revoked</h3>
          </div>
        </div>

        <div class="why-matters-title">Why this matters</div>
        <ul class="why-matters-list">
          <li><span>✓</span> Preserves a complete, auditable history.</li>
          <li><span>✓</span> Distinguishes REVOKED from TAMPERED.</li>
          <li><span>✓</span> Matches how real institutions correct errors.</li>
        </ul>
      </div>

    </div>

    <!-- BOTTOM: Revocation Records Section -->
    <div class="card">
      <div class="records-header-bar">
        <div class="records-title"><span>⏱️</span> Revocation Records</div>
        <div class="revoked-count-badge">
          <%= locals.revokedList ? revokedList.length : 0 %> revoked
        </div>
      </div>

      <div class="records-body">
        <% if (!locals.revokedList || revokedList.length===0) { %>
          <div class="empty-records">No revoked credentials recorded.</div>
          <% } else { %>
            <% revokedList.forEach(item=> { %>
              <div class="record-row-card">
                <div class="record-col">
                  <label>CERTIFICATE ID</label>
                  <div class="val font-mono">
                    <%= item.cert_id %>
                  </div>
                  <div class="sub-name">
                    <%= item.student_name %>
                  </div>
                </div>
                <div class="record-col">
                  <label>STATUS</label>
                  <div class="val"><span class="badge-revoked">● REVOKED</span></div>
                </div>
                <div class="record-col">
                  <label>REASON</label>
                  <!-- Updated to match Postgres column name -->
                  <div class="val">
                    <%= item.revocation_reason %>
                  </div>
                </div>
                <div class="record-col">
                  <label>REVOKED ON</label>
                  <!-- Updated to match Postgres column name and format the date properly -->
                  <div class="val">
                    <%= item.revoked_date ? new Date(item.revoked_date).toLocaleDateString() : 'N/A' %>
                  </div>
                </div>
              </div>
              <% }) %>
                <% } %>
      </div>
    </div>

  </main>

</body>

</html>