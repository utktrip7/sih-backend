<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abhedya - Administration Console</title>

    <!-- Links to your specific Overview CSS file -->
    <link rel="stylesheet" href="/css/pages/administration_login.css">
</head>

<body>
    <div class="card">
        <div class="logo-container">
            <div class="logo-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111A28" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <span class="logo-text">Abhedya</span>
        </div>

        <div class="header-text">
            <h1>Welcome back</h1>
            <p>Sign in to issue and manage credentials</p>
        </div>

        <% if (locals.error) { %>
            <div class="error-alert">
                Incorrect password. Please try again.
            </div>
            <% } %>

                <form action="/administration_login" method="POST">
                    <div class="input-group">
                        <label for="password">Institution password</label>
                        <div class="input-wrapper">
                            <input type="password" id="password" name="password" placeholder="Enter password"
                                required />
                            <button type="button" class="toggle-eye" onclick="togglePasswordVisibility()">
                                <svg id="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn">Enter console</button>
                </form>

                <div class="footer">
                    Demo password: <span>nitr769008</span>
                </div>
    </div>

    <!-- Lottie Player Script -->
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

    <!-- Transition Overlay -->
    <div id="transition-overlay">
        <lottie-player src="https://lottie.host/28cc0d91-b674-43a9-ad22-230fa6d57093/fXDg9P20Li.json"
            background="transparent" speed="1" style="width: 250px; height: 250px;" loop autoplay>
        </lottie-player>
    </div>

    <script>
        function togglePasswordVisibility() {
            const pwd = document.getElementById("password");
            pwd.type = pwd.type === "password" ? "text" : "password";
        }

        const adminForm = document.querySelector("form");
        const overlay = document.getElementById("transition-overlay");
        const submitBtn = document.querySelector(".submit-btn");

        adminForm.addEventListener("submit", function (e) {
            e.preventDefault();

            // 1. Instant Visual Feedback
            submitBtn.innerText = "Checking...";
            submitBtn.style.opacity = "0.7";
            submitBtn.disabled = true;

            // 2. Show the overlay
            overlay.style.display = "flex";

            setTimeout(() => {
                overlay.style.opacity = "1";
            }, 10);

            // 3. Submit immediately. The animation will play until the server
            // responds with the dashboard, or reloads the page with an error.
            adminForm.submit();
        });
    </script>

</body>

</html>