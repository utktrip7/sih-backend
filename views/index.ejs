      function slideNextNeo() {
        const track = document.getElementById("neoTrack");
        // Scrolls by one card width + the gap
        track.scrollBy({ left: 284, behavior: "smooth" });

        // Loop back to the start if they hit the end
        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
          track.scrollTo({ left: 0, behavior: "smooth" });
