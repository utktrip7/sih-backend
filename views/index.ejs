    <!-- 1. Anime.js Text Script -->
    <script>
      const textEl = document.getElementById("hero-animation-text");
      const originalText = textEl.textContent;
      textEl.innerHTML = originalText
        .split("")
        .map((char) => {
          if (char === " ") return " ";
          return `<span class="letter">${char}</span>`;
        })
        .join("");

      window.addEventListener("DOMContentLoaded", () => {
        anime.timeline({ loop: false }).add({
          targets: "#hero-animation-text .letter",
          translateY: [40, 0],
          opacity: [0, 1],
          easing: "easeOutExpo",
          duration: 900,
          delay: anime.stagger(35),
        });
      });
    </script>

    <!-- 2. Infinite Loop Carousel Script (The Clone Hack) -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const track = document.getElementById("track");

        let originalSlides = Array.from(
          document.querySelectorAll(".carousel-slide"),
        );

        const firstClone = originalSlides[0].cloneNode(true);
        const lastClone =
          originalSlides[originalSlides.length - 1].cloneNode(true);

        track.appendChild(firstClone);
        track.insertBefore(lastClone, originalSlides[0]);

        const slides = Array.from(document.querySelectorAll(".carousel-slide"));

        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");
        const playPauseBtn = document.getElementById("playPauseBtn");
        const playIcon = document.getElementById("playIcon");
        const pauseIcon = document.getElementById("pauseIcon");

        let currentIndex = 1;
        let isPlaying = true;
        let autoSlideInterval;
        let isTransitioning = false;
        const slideDuration = 3000;

        const slideWidthPercent = 70;
        const gapPercent = 2;
        const centerOffset = (100 - slideWidthPercent) / 2; // 15%
        const shiftAmount = slideWidthPercent + gapPercent; // 72%

        const updateSlidePosition = (animate = true) => {
          if (!animate) {
            track.style.transition = "none";
            slides.forEach((s) => (s.style.transition = "none"));
          } else {
            track.style.transition =
              "transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)";
            slides.forEach(
              (s) =>
                (s.style.transition = "all 0.6s cubic-bezier(0.25, 1, 0.5, 1)"),
            );
          }

          const translateValue = centerOffset - currentIndex * shiftAmount;
          track.style.transform = `translateX(${translateValue}%)`;

          slides.forEach((slide, index) => {
            if (index === currentIndex) {
              slide.classList.add("active-slide");
            } else {
              slide.classList.remove("active-slide");
            }
          });

          if (!animate) track.offsetHeight;
        };

        const moveToNextSlide = () => {
          if (isTransitioning) return;
          isTransitioning = true;
          currentIndex++;
          updateSlidePosition(true);
        };

        const moveToPrevSlide = () => {
          if (isTransitioning) return;
          isTransitioning = true;
          currentIndex--;
          updateSlidePosition(true);
        };

        track.addEventListener("transitionend", () => {
          isTransitioning = false;

          if (currentIndex === slides.length - 1) {
            currentIndex = 1;
            updateSlidePosition(false);
          }

          if (currentIndex === 0) {
            currentIndex = slides.length - 2;
            updateSlidePosition(false);
          }
        });

        const startAutoPlay = () => {
          if (!autoSlideInterval) {
            autoSlideInterval = setInterval(moveToNextSlide, slideDuration);
          }
        };

        const stopAutoPlay = () => {
          clearInterval(autoSlideInterval);
          autoSlideInterval = null;
        };

        nextBtn.addEventListener("click", () => {
          moveToNextSlide();
          if (isPlaying) {
            stopAutoPlay();
            startAutoPlay();
          }
        });

        prevBtn.addEventListener("click", () => {
          moveToPrevSlide();
          if (isPlaying) {
            stopAutoPlay();
            startAutoPlay();
          }
        });

        playPauseBtn.addEventListener("click", () => {
          if (isPlaying) {
            stopAutoPlay();
            pauseIcon.style.display = "none";
            playIcon.style.display = "block";
          } else {
            startAutoPlay();
            playIcon.style.display = "none";
            pauseIcon.style.display = "block";
          }
          isPlaying = !isPlaying;
        });

        updateSlidePosition(false);
        startAutoPlay();
      });
    </script>

