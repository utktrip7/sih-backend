<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Abhedya | Blockchain Ledger</title>

  <link rel="stylesheet" href="/css/pages/ledger.css">
</head>
<body>

  <!-- Top Dark Navigation Bar -->
  <header>
    <div class="brand-section">
      <div class="brand-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <div class="brand-text">
        <h2>Abhedya</h2>
        <span>Credential Console</span>
      </div>
    </div>

    <ul class="nav-links">
      <li>
        <a href="/dashboard">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Overview
        </a>
      </li>
      <li>
        <a href="/dashboard/issue">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Issue & Verify
        </a>
      </li>
      <li>
        <a href="/dashboard/revoke">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          Revocation Registry
        </a>
      </li>
      <li>
        <a href="/dashboard/ledger" class="active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><path d="M10 6.5h4M6.5 10v4M17.5 10v4M10 17.5h4"/></svg>
          Ledger
        </a>
      </li>
    </ul>

    <div class="header-right">
      <button class="btn-logout">Logout</button>
    </div>
  </header>

  <!-- Centered Content Canvas -->
  <main class="dashboard-content">

    <div class="page-header">
      <h1>Blockchain Ledger</h1>
      <p>Append-only, hash-linked record of every credential ever issued.</p>
    </div>

    <!-- Chain Integrity Status Banner -->
    <% if (locals.chainStatus && chainStatus.valid) { %>
      <div class="chain-status chain-valid">
        <span class="status-icon">✓</span>
        <div>
          <div class="status-title">Chain Intact</div>
          <div class="status-desc">Every block's hash matches its recorded data, and each block correctly links to the one before it.</div>
        </div>
      </div>
    <% } else { %>
      <div class="chain-status chain-broken">
        <span class="status-icon">✕</span>
        <div>
          <div class="status-title">Chain Broken<% if (locals.chainStatus && chainStatus.brokenAtBlock) { %> — at Block #<%= chainStatus.brokenAtBlock %><% } %></div>
          <div class="status-desc">A recomputed hash doesn't match the stored value. This means a record was altered after being written to the ledger.</div>
        </div>
      </div>
    <% } %>

    <!-- Ledger Table -->
    <div class="card">
      <div class="records-header-bar">
        <div class="records-title"><span>⛓️</span> Ledger Blocks</div>
        <div class="block-count-badge"><%= locals.blocks ? blocks.length : 0 %> blocks</div>
      </div>

      <div class="ledger-table-wrap">
        <% if (!locals.blocks || blocks.length === 0) { %>
          <div class="empty-records">No blocks recorded yet. Issue a credential to create the genesis block.</div>
        <% } else { %>
          <table class="ledger-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Certificate</th>
                <th>Data Hash</th>
                <th>Previous Block Hash</th>
                <th>Block Hash</th>
                <th>Timestamp</th>
              </tr>
            </thead>
            <tbody>
              <% blocks.forEach(block => { %>
                <tr>
                  <td class="block-index">#<%= block.block_index %></td>
                  <td class="font-mono"><%= block.credential_id %></td>
                  <td class="font-mono hash-cell" title="<%= block.data_hash %>"><%= block.data_hash %></td>
                  <td class="font-mono hash-cell" title="<%= block.previous_block_hash %>"><%= block.previous_block_hash %></td>
                  <td class="font-mono hash-cell" title="<%= block.block_hash %>"><%= block.block_hash %></td>
                  <td class="timestamp-cell"><%= block.created_at %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

  </main>

</body>
</html>
