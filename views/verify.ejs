<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Abhedya | Verification Profile</title>
  <link rel="stylesheet" href="/css/pages/verify.css">
</head>

<body>

  <!-- Top Dark Header Navigation (External Public View) -->
  <header>
    <div class="brand-section">
      <img src="/images/logo.jpeg" alt="Abhedya Logo" class="brand-logo-img">
      
      <div class="brand-text">
        <h2>Abhedya</h2>
        <span>Public Verification Portal</span>
      </div>
    </div>
  </header>

  <!-- Centered Content Canvas -->
  <main class="dashboard-content">
    <div class="page-header">
      <h1>Verification Profile</h1>
      <p>Cryptographically verify academic credentials against the immutable database.</p>
    </div>

    <!-- 2-Column Grid Wrapper -->
    <div class="verify-grid">

      <!-- LEFT COLUMN: Search Card -->
      <div class="card">
        <span class="card-badge">PUBLIC VERIFICATION</span>
        <h2 class="card-title">Scan a Credential</h2>

        <form id="verifyForm" action="/verify-action" method="POST">
          <div class="input-group">
            <label>Certificate ID</label>
            <input type="text" name="certId" placeholder="Enter ID (e.g. CERT-XXXX)" required
              value="<%= typeof prefillId !== 'undefined' && prefillId ? prefillId : (typeof verifiedData !== 'undefined' && verifiedData && !verifiedData.notFound ? verifiedData.id : '') %>">
          </div>
          <button type="submit" class="btn-submit">Look up</button>
        </form>

        <p class="helper-text">Scan the QR code on a certificate, or enter its ID manually.</p>
      </div>

      <!-- RIGHT COLUMN: Results Display Card -->
      <div class="card">
        <span class="card-badge">OUTPUT PREVIEW</span>
        <h3 class="card-title">Verification Result</h3>

        <!-- STATE 1: Empty -->
        <% if (typeof verifiedData==='undefined' || !verifiedData) { %>
          <div class="empty-state-box">
            <div class="qr-icon">🛡️</div>
            <p>Enter a certificate ID on the left to securely verify the credential.</p>
          </div>

          <!-- STATE 2: Not Found -->
          <% } else if (verifiedData.notFound) { %>
            <div class="empty-state-box error-state">
              <div class="qr-icon">⚠️</div>
              <p style="font-weight: 600;">Credential Not Found</p>
              <p style="font-size: 0.85rem; margin-top: 5px;">There is no record of this certificate ID in the database.
              </p>
            </div>

            <!-- STATE 3: Real Database Match -->
            <% } else { %>
              <div class="success-state-box">

                <!-- THE KILL SWITCH: Check if Revoked FIRST -->
                <% if (verifiedData.isRevoked) { %>
                  <div class="status-badge error"
                    style="background-color: #fef2f2; color: #991b1b; border: 2px solid #ef4444; padding: 12px;">
                    <div style="font-size: 1.1rem; font-weight: 800; margin-bottom: 4px;">⚠️ CREDENTIAL REVOKED</div>
                    <div style="font-size: 0.85rem; font-weight: normal;">This document was permanently invalidated by
                      the institution.</div>
                  </div>
                  <div
                    style="background-color: #fee2e2; padding: 10px; border-radius: 6px; margin-bottom: 1.5rem; font-size: 0.9rem; color: #991b1b;">
                    <strong>Reason:</strong>
                    <%= verifiedData.revocationReason %>
                  </div>

                  <!-- UPDATED: We now check isValid instead of just isMatch, so a broken signature triggers the tamper alert too! -->
                  <% } else if (verifiedData.isValid) { %>
                    <div class="status-badge success">✅ Verified & Authentic</div>
                    <% } else { %>
                      <div class="status-badge error">❌ Tamper Alert: Invalid Credential</div>
                      <% } %>

                        <!-- Document Data Audit Trail -->
                        <div class="data-row">
                          <strong>Name:</strong>
                          <%= verifiedData.studentName %>
                        </div>
                        <div class="data-row">
                          <strong>Cert ID:</strong>
                          <%= verifiedData.id %>
                        </div>
                        <div class="data-row">
                          <strong>Document Type:</strong>
                          <span style="color: #2563eb; font-weight: 600;">
                            <%= verifiedData.docType || 'Official Degree' %>
                          </span>
                        </div>
                        <div class="data-row">
                          <strong>Degree:</strong>
                          <%= verifiedData.degree %>
                        </div>
                        <div class="data-row">
                          <strong>Branch:</strong>
                          <span
                            style="color: <%= (!verifiedData.isRevoked && !verifiedData.isValid) ? '#dc2626' : 'inherit' %>; font-weight: <%= (!verifiedData.isRevoked && !verifiedData.isValid) ? '600' : 'normal' %>;">
                            <%= verifiedData.branch %>
                          </span>
                        </div>
                        <div class="data-row">
                          <strong>Grad Year:</strong>
                          <%= verifiedData.gradYear %>
                        </div>

                        <!-- DYNAMIC LAYOUT: Render Full Grade Table if it's a Marksheet -->
                        <% if (verifiedData.docType==='Semester Marksheet' ) { %>
                          <div style="margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 15px;">
                            <h4 style="font-size: 0.95rem; font-weight: 700; color: #0f172a; margin-bottom: 10px;">
                              Semester Grade Report Preview</h4>
                            <div
                              style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; font-size: 0.8rem;">
                              <div
                                style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px; margin-bottom: 6px; color: #64748b; font-weight: bold;">
                                <span style="flex: 2;">Course</span>
                                <span style="flex: 1; text-align: center;">Credits</span>
                                <span style="flex: 1; text-align: right;">Grade</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 5px 0;">
                                <span style="flex: 2;">CH-101 Thermodynamics</span>
                                <span style="flex: 1; text-align: center;">4</span>
                                <span style="flex: 1; text-align: right; font-weight: bold;">A</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 5px 0;">
                                <span style="flex: 2;">CH-103 Fluid Mechanics</span>
                                <span style="flex: 1; text-align: center;">4</span>
                                <span style="flex: 1; text-align: right; font-weight: bold;">EX</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 5px 0;">
                                <span style="flex: 2;">MA-201 Numerical Methods</span>
                                <span style="flex: 1; text-align: center;">3</span>
                                <span style="flex: 1; text-align: right; font-weight: bold;">B</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 5px 0;">
                                <span style="flex: 2;">CY-102 Engineering Chemistry</span>
                                <span style="flex: 1; text-align: center;">3</span>
                                <span style="flex: 1; text-align: right; font-weight: bold;">A</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 5px 0;">
                                <span style="flex: 2;">HS-104 Professional Comm.</span>
                                <span style="flex: 1; text-align: center;">2</span>
                                <span style="flex: 1; text-align: right; font-weight: bold;">EX</span>
                              </div>
                              <div
                                style="margin-top: 10px; border-top: 1px solid #e2e8f0; padding-top: 8px; text-align: right; font-weight: bold; color: #1e293b;">
                                SGPA: 9.15 / 10.0
                              </div>
                            </div>
                          </div>
                          <% } %>

                            <!-- HASHES -->
                            <div class="hash-display mt-4">
                              <div class="hash-label">Original Database Hash:</div>
                              <div class="hash-string">
                                <%= verifiedData.originalHash %>
                              </div>
                            </div>

                            <div class="hash-display" <%- verifiedData.isMatch
                              ? 'style="background-color: #f8fafc; border-color: #e2e8f0;"'
                              : 'style="background-color: #fef2f2; border-color: #fca5a5;"' %>>
                              <div class="hash-label">Calculated Verification Hash:</div>
                              <div class="hash-string" <%- verifiedData.isMatch ? 'style="color: #0f172a;"'
                                : 'style="color: #dc2626;"' %>>
                                <%= verifiedData.recomputedHash %>
                              </div>
                            </div>

                            <!-- ========================================== -->
                            <!-- NEW: DIGITAL SIGNATURE VERIFICATION BLOCK  -->
                            <!-- ========================================== -->
                            <div style="margin-top: 20px; padding-top: 15px; border-top: 1px solid #e2e8f0;">
                              <h4 style="font-size: 0.95rem; font-weight: 700; color: #0f172a; margin-bottom: 10px;">
                                Cryptographic Signature Status
                              </h4>
                              
                              <% if (!verifiedData.isSigned) { %>
                                <div style="background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 12px; color: #b45309; font-size: 0.85rem; display: flex; align-items: center; gap: 10px;">
                                  <span style="font-size: 1.2rem;">⚠️</span>
                                  <div>
                                    <strong>Unsigned (Legacy Record)</strong><br>
                                    This document was issued before the Ed25519 signature upgrade. Data matches database, but cryptographic origin cannot be proven.
                                  </div>
                                </div>
                              <% } else if (verifiedData.signatureValid) { %>
                                <div style="background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 12px; color: #065f46; font-size: 0.85rem; display: flex; align-items: flex-start; gap: 10px;">
                                  <span style="font-size: 1.2rem; margin-top: 2px;">✅</span>
                                  <div>
                                    <strong>Verified Cryptographically</strong><br>
                                    Signature mathematically verified against the institution's public key. Origin is authentic.<br>
                                    <div style="margin-top: 6px; font-family: monospace; font-size: 0.7rem; color: #059669; word-break: break-all; background: rgba(16, 185, 129, 0.1); padding: 6px; border-radius: 4px;">
                                      <%= verifiedData.signature %>
                                    </div>
                                  </div>
                                </div>
                              <% } else { %>
                                <div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px; color: #991b1b; font-size: 0.85rem; display: flex; align-items: flex-start; gap: 10px;">
                                  <span style="font-size: 1.2rem; margin-top: 2px;">❌</span>
                                  <div>
                                    <strong>INVALID SIGNATURE - Tamper Detected</strong><br>
                                    The digital signature does not match the computed hash. This document has been forged or altered by someone without the Private Key.<br>
                                    <div style="margin-top: 6px; font-family: monospace; font-size: 0.7rem; color: #b91c1c; word-break: break-all; background: rgba(239, 68, 68, 0.1); padding: 6px; border-radius: 4px;">
                                      <%= verifiedData.signature %>
                                    </div>
                                  </div>
                                </div>
                              <% } %>
                            </div>

              </div>
              <% } %>
      </div>

    </div>
  </main>

  <!-- MAGIC AUTO-SUBMIT SCRIPT FOR QR SCANS -->
  <% if (typeof prefillId !=='undefined' && prefillId && (typeof verifiedData==='undefined' || !verifiedData)) { %>
    <script>
      window.onload = function () {
        document.getElementById("verifyForm").submit();
      };
    </script>
    <% } %>

</body>

</html>